PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cabbagemail?schema=public
JWT_SECRET=super_secret_cabbage_mail_jwt_key_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# EMAIL DISPATCH PROVIDER SWITCH: 'AWS' | 'SMTP' | 'MOCK'
# Set EMAIL_PROVIDER=AWS to use AWS SNS / SES
# Set EMAIL_PROVIDER=SMTP to use Gmail / Custom SMTP
# Set EMAIL_PROVIDER=MOCK for instant zero-credential local testing
# -------------------------------------------------------------
EMAIL_PROVIDER=SMTP

# Gmail / Universal SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=false
SMTP_FROM=The Cabbage Mail <your_email@gmail.com>

# AWS SNS / SES Credentials (Used when EMAIL_PROVIDER=AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
