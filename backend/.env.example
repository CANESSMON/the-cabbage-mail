PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emailbhejo?schema=public
JWT_SECRET=super_secret_emailbhejo_jwt_key_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# EMAIL DISPATCH PROVIDER SWITCH: 'AWS' | 'MOCK'
# Set EMAIL_PROVIDER=AWS to send via AWS SES Cloud Infrastructure
# Set EMAIL_PROVIDER=MOCK for instant zero-credential local testing
# -------------------------------------------------------------
EMAIL_PROVIDER=AWS

# AWS SES Credentials (Used when EMAIL_PROVIDER=AWS)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=YOUR_IAM_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_IAM_SECRET_ACCESS_KEY
SES_FROM_EMAIL=info@emailbhejo.com
SES_FROM_NAME=EmailBhejo
